# Avoid spaces and URL-reserved characters (e.g. @, :, /, ?, #, %).
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydatabase

# Host ports.
POSTGRES_PORT=5432
API_PORT=8000

# Exact browser origin, without a trailing slash. Native clients may omit Origin.
FRONTEND_ORIGIN=http://localhost:3000
# Local HTTP only. Set true when serving the API over HTTPS.
COOKIE_SECURE=false

# Optional runtime overrides (defaults shown).
# DATABASE_MAX_CONNECTIONS=10
# Includes waiting for a pooled connection; not a query timeout.
# DATABASE_CONNECT_TIMEOUT_SECONDS=10
# SESSION_TTL_SECONDS=86400

# Log verbosity (e.g. info or rust_backend_boilerplate=debug).
# RUST_LOG=info
